{
  "name": "cesium-wind-layer",
  "version": "0.11.1",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "tsup src/index.ts --format cjs,esm --dts --sourcemap --external cesium --watch",
    "build": "tsup src/index.ts --format cjs,esm --dts --sourcemap --external cesium --tsconfig tsconfig.json",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix"
  },
  "peerDependencies": {
    "cesium": ">=1.119.0 <2"
  },
  "devDependencies": {
    "cesium": "^1.136.0",
    "tsup": "^8.0.2",
    "typescript": "^5.5.3"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NOC-OI/cesium-wind-layer.git",
    "directory": "packages/cesium-wind-layer"
  },
  "bugs": {
    "url": "https://github.com/NOC-OI/cesium-wind-layer/issues"
  },
  "homepage": "https://github.com/NOC-OI/cesium-wind-layer#readme",
  "license": "MIT"
}
